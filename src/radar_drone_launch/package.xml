<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>radar_drone_launch</name>
  <version>0.0.0</version>
  <description>Launch all packages and nodes</description>
  <maintainer email="aaronzzwang@gmail.com">aaron</maintainer>
  <license>MIT</license>

  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>mavros</exec_depend>
  <exec_depend>ouster_ros</exec_depend>
  <exec_depend>orbbec_camera</exec_depend>
  <exec_depend>py_perception</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
