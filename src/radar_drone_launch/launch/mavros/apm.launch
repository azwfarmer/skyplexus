<launch>
	<!-- vim: set ft=xml noet : -->
	<!-- example launch script for ArduPilot based FCU's -->

	<arg name="fcu_url" default="/dev/ttyTHS1:921600" />
	<arg name="gcs_url" default="" />
	<arg name="tgt_system" default="1" />
	<arg name="tgt_component" default="1" />
	<arg name="log_output" default="log" />
	<arg name="fcu_protocol" default="v2.0" />
	<arg name="respawn_mavros" default="false" />
	<arg name="namespace" default="mavros"/>
	<include file="/workspaces/isaac_ros-dev/isaac_ros_common/src/radar_drone_launch/launch/mavros/node.launch">
		<arg name="pluginlists_yaml" value="/workspaces/isaac_ros-dev/isaac_ros_common/src/radar_drone_launch/launch/mavros/apm_pluginlists.yaml" />
		<arg name="config_yaml" value="/workspaces/isaac_ros-dev/isaac_ros_common/src/radar_drone_launch/launch/mavros/apm_config.yaml" />
		<arg name="fcu_url" value="$(var fcu_url)" />
		<arg name="gcs_url" value="$(var gcs_url)" />
		<arg name="tgt_system" value="$(var tgt_system)" />
		<arg name="tgt_component" value="$(var tgt_component)" />
		<arg name="fcu_protocol" value="$(var fcu_protocol)" />
		<arg name="respawn_mavros" value="$(var respawn_mavros)" />
		<arg name="namespace" value="$(var namespace)"/>
	</include>
</launch>
