WORKDIR /
RUN git clone https://github.com/azinke/mmwave.git && \
    cd /mmwave && \
    sudo make install

RUN echo '${USERNAME} ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

RUN echo export PATH=/home/admin/.local/bin:$PATH >> ~/.bashrc

USER ${USERNAME}
RUN --mount=type=cache,target=/var/cache/apt \
    rosdep update

USER root