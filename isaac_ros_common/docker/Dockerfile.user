ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Setup non-root admin user
ARG USERNAME=admin
ARG USER_UID=1000
ARG USER_GID=1000

# Install prerequisites
RUN --mount=type=cache,target=/var/cache/apt \
apt-get update && apt-get install -y \
        sudo \
        udev

# Reuse triton-server user as 'admin' user if exists
RUN if [ $(getent group triton-server) ]; then \
        groupmod -o --gid ${USER_GID} -n ${USERNAME} triton-server ; \
        usermod -l ${USERNAME} -u ${USER_UID} -m -d /home/${USERNAME} triton-server ; \
        mkdir -p /home/${USERNAME} ; \
        sudo chown ${USERNAME}:${USERNAME} /home/${USERNAME} ; \
        # Wipe files that may create issues for users with large uid numbers.
        rm -f /var/log/lastlog /var/log/faillog ; \
    fi

# Create the 'admin' user if not already exists
RUN if [ ! $(getent passwd ${USERNAME}) ]; then \
        groupadd --gid ${USER_GID} ${USERNAME} ; \
        useradd --no-log-init --uid ${USER_UID} --gid ${USER_GID} -m ${USERNAME} ; \
    fi

# Update 'admin' user
RUN echo ${USERNAME} ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/${USERNAME} \
    && chmod 0440 /etc/sudoers.d/${USERNAME} \
    && adduser ${USERNAME} video && adduser ${USERNAME} plugdev && adduser ${USERNAME} sudo

# Copy scripts
RUN mkdir -p /usr/local/bin/scripts
COPY scripts/*entrypoint.sh /usr/local/bin/scripts/
RUN  chmod +x /usr/local/bin/scripts/*.sh

# Copy middleware profiles
RUN mkdir -p /usr/local/share/middleware_profiles
COPY middleware_profiles/*profile.xml /usr/local/share/middleware_profiles/

ENV USERNAME=${USERNAME}
ENV USER_GID=${USER_GID}
ENV USER_UID=${USER_UID}
RUN --mount=type=cache,target=/var/cache/apt \
    apt-get remove -y python3-matplotlib

RUN wget https://raw.githubusercontent.com/mavlink/mavros/master/mavros/scripts/install_geographiclib_datasets.sh && \
    chmod a+x install_geographiclib_datasets.sh && \
    ./install_geographiclib_datasets.sh

RUN pip install PyYAML mavproxy --user

RUN echo 'export PATH="$PATH:$HOME/.local/bin"' >> ~/.bashrc

RUN pip install ouster-sdk

RUN --mount=type=cache,target=/var/cache/apt \
    apt-get update && \
    add-apt-repository ppa:nuandllc/bladerf && \
    add-apt-repository ppa:borglab/gtsam-release-4.1 && \
    apt-get update && apt-get install -y ros-humble-isaac-ros-jetson-stats \
    ros-humble-pcl-conversions \
    minicom ros-humble-isaac-ros-common \
    ros-humble-isaac-ros-gxf \
    ros-humble-isaac-ros-nitros \
    ros-humble-isaac-ros-nitros-camera-info-type \
    ros-humble-isaac-ros-nitros-image-type \
    ros-humble-isaac-ros-stereo-image-proc \
    ros-humble-isaac-ros-image-proc \
    ros-humble-gxf-isaac-argus \
    ros-humble-gxf-isaac-atlas \
    ros-humble-gxf-isaac-gxf-helpers \
    ros-humble-gxf-isaac-messages \
    ros-humble-gxf-isaac-message-compositor \
    ros-humble-gxf-isaac-rectify \
    ros-humble-gxf-isaac-sight \
    ros-humble-gxf-isaac-tensorops \
    ros-humble-gxf-isaac-timestamp-correlator \
    ros-humble-isaac-ros-test \
    ros-humble-gxf-isaac-gems \
    ros-humble-septentrio-gnss-driver \
    python3-dev \
    python3-opencv \
    python3-wxgtk4.0 \
    python3-pip \
    python3-lxml \
    python3-pygame \
    gnome-terminal \
    dbus-x11 \
    gtk+3.0 gitk x11-apps gdb gdbserver \
    ros-humble-pcl-ros     \
    ros-humble-tf2-eigen   \
    ros-humble-rviz2        \
    build-essential         \
    libeigen3-dev \
    libepoxy-dev \
    libcgal-dev \
    libmetis-dev \
    libfreeimage-dev \
    python3-colcon-common-extensions \
    linuxptp ethtool nano ntpdate ntp \
    ros-humble-rqt-runtime-monitor \
    bladerf \
    libbladerf-dev \
    libsndfile1-dev \
    libsdl1.2-dev \
    ocl-icd-opencl-dev \
    libfreetype6 \
    libfreetype6-dev \
    bladerf-firmware-fx3 \
    bladerf-fpga-hostedxa9 \
    gnuradio \
    ros-humble-perception-pcl \
    ros-humble-xacro \
    libgtsam-dev \
    libgtsam-unstable-dev \
    pcl-tools \
    libspdlog-dev \
    libhdf5-serial-dev \
    hdf5-tools \
    nvidia-tensorrt-dev \
    python3-libnvinfer-dev \
    eog \
    nvidia-tensorrt-dev \
    libgflags-dev nlohmann-json3-dev  \
    ros-humble-image-transport \
    ros-humble-image-publisher \
    ros-humble-camera-info-manager \
    ros-humble-diagnostic-updater \
    ros-humble-diagnostic-msgs \
    ros-humble-statistics-msgs \
    ros-humble-backward-ros \
    libdw-dev \
    net-tools \
    && rm -rf /var/lib/apt/lists/*

COPY ptp4l.conf /etc/linuxptp/ptp4l.conf

COPY libcusparse_lt-linux-sbsa-0.5.2.1-archive/include/* /usr/local/cuda/include/
COPY libcusparse_lt-linux-sbsa-0.5.2.1-archive/lib/* /usr/local/cuda/lib64/
RUN ldconfig

WORKDIR /tmp/torchvision
COPY torchvision/ /tmp/torchvision
RUN python3 /tmp/torchvision/setup.py install
RUN rm -rf /tmp/torchvision

RUN pip3 install PyYAML \
    mavproxy \
    ouster-sdk \
    einops \
    tqdm \
    onnxsim \
    git+https://github.com/alibaba/TinyNeuralNetwork.git \
    pycocotools \
    lvis \
    gradio \
    gradio-clickable-arrow-dropdown \
    gradio-box-promptable-image \
    gradio-point-promptable-image \
    gradio-sbmp-promptable-image \
    ros2_numpy \
    timm==0.6.13 \
    git+https://github.com/zhijian-liu/torchpack.git@3a5a9f7ac665444e1eb45942ee3f8fc7ffbd84e5 \
    onnxruntime \
    segment_anything \
    onnx 
